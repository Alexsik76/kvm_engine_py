# provision.env — copy to provision.env and adjust, OR rely on autodetected defaults.
# Every value here is a deployment parameter. Nothing personal is baked into the scripts.

# The OS user that owns the project and runs the provisioning (you SSH in as this user).
# Default: the user invoking sudo (autodetected). Override only if needed.
# KVM_DEVICE_USER=kvmadmin

# Wired network interface MediaMTX advertises for WebRTC ICE.
# Raspberry Pi OS Bookworm+ often names it end0; older images use eth0.
KVM_WEBRTC_IFACE=eth0

# MediaMTX release to install (must match the arm64 build tested with this project).
MEDIAMTX_VERSION=v1.16.2

# Pinned single-header dependency for the C++ engine build.
NLOHMANN_JSON_VERSION=v3.12.0
