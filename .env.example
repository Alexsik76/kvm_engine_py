# KVM Deploy Settings
KVM_DEVICE_USER=kvmowner
KVM_DEVICE_HOST=kvm-ipi
KVM_ACCESS_MODE=lan
KVM_PUBLIC_HOST=""
KVM_WEBRTC_UDP_PORT=30000
KVM_WEBRTC_ADDITIONAL_HOSTS=""
KVM_ENABLE_STUN=false

# Network interface for WebRTC candidates.
# Note: Recent Raspberry Pi OS may name the wired interface "end0" instead of "eth0".
KVM_WEBRTC_IFACE=eth0
KVM_RTSP_SERVER=127.0.0.1:8554

# CORS settings: Comma-separated list of allowed origins.
# For single-origin deployment (SPA served from the Pi), keep empty.
# Only needed for desktop clients or split-origin setups.
KVM_CORS_ALLOWED_ORIGINS=""

# MediaMTX Credentials
KVM_MEDIAMTX_USER=kvm_user
KVM_MEDIAMTX_PASS=PLACEHOLDER_MTX_PASS

# Secrets
KVM_JWT_SECRET=PLACEHOLDER_JWT_SECRET

# Optional Path overrides (leave empty to build from DEVICE_USER)
# KVM_PROJECT_ROOT=
# KVM_MEDIAMTX_PATH=
# KVM_EDID_PATH=
# KVM_KVM_ENGINE_BIN=

# Hardware Settings
# KVM_VIDEO_DEVICE=
# KVM_HID_PORT=
# KVM_KEYBOARD_DEVICE=
# KVM_MOUSE_DEVICE=
# KVM_LOG_LEVEL=
# KVM_FRONT_PANEL_ENABLED=
# KVM_FRONT_PANEL_PORT=
# KVM_FRONT_PANEL_BAUDRATE=
